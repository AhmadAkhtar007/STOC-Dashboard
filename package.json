{
  "name": "stoc-dashboard",
  "productName": "STOC Energy Meter Test System",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server-url=http://127.0.0.1:5173\"",
    "build:web": "tsc -b && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron --external:serialport && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build:desktop": "npm run build:web && npm run build:electron",
    "start:electron": "electron .",
    "package:win": "npm run build:desktop && electron-builder --win portable",
    "pretest": "npm run test:types",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.types.json"
  },
  "build": {
    "appId": "com.stoc.energy-meter-dashboard",
    "productName": "STOC Energy Meter Test System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@serialport/**",
      "node_modules/serialport/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.9.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
